<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp"
        android:paddingEnd="24dp"
        android:paddingStart="24dp"
        android:paddingTop="20dp">

        <!-- En-tête : titre à gauche, logo RB dans le coin -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginEnd="14dp"
                android:contentDescription="@string/logo_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_qr" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tagline"
                    android:textColor="@color/neon_cyan"
                    android:textSize="11sp"
                    android:letterSpacing="0.2"
                    android:textAllCaps="true" />
            </LinearLayout>

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@string/logo_rb_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_rb" />
        </LinearLayout>

        <TextView
            style="@style/Section"
            android:layout_marginTop="24dp"
            android:text="@string/mode_title" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-4dp"
            android:layout_marginEnd="-4dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/modeSender"
                style="@style/ModeCard"
                android:text="@string/mode_sender" />

            <RadioButton
                android:id="@+id/modeReceiver"
                style="@style/ModeCard"
                android:text="@string/mode_receiver" />
        </RadioGroup>

        <!-- ===== Mode Émetteur ===== -->
        <LinearLayout
            android:id="@+id/senderPanel"
            style="@style/Card"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/Section"
                android:text="@string/section_framing" />

            <Switch
                android:id="@+id/cropSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/sender_crop"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:thumbTint="@color/neon_cyan"
                android:trackTint="@color/neon_violet" />

            <Switch
                android:id="@+id/fillSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/sender_fill"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:thumbTint="@color/neon_cyan"
                android:trackTint="@color/neon_violet" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/sender_crop_hint"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <TextView android:id="@+id/zoomLabel" style="@style/Label" />
            <SeekBar android:id="@+id/zoomSeek" style="@style/Seek" android:max="100" />

            <TextView android:id="@+id/offsetXLabel" style="@style/Label" />
            <SeekBar android:id="@+id/offsetXSeek" style="@style/Seek" android:max="200" />

            <TextView android:id="@+id/offsetYLabel" style="@style/Label" />
            <SeekBar android:id="@+id/offsetYSeek" style="@style/Seek" android:max="200" />

            <TextView
                style="@style/Section"
                android:layout_marginTop="26dp"
                android:text="@string/section_quality" />

            <TextView android:id="@+id/bitrateLabel" style="@style/Label" android:layout_marginTop="10dp" />
            <SeekBar android:id="@+id/bitrateSeek" style="@style/Seek" android:max="8" />

            <Button
                android:id="@+id/senderDirectButton"
                style="@style/GhostButton"
                android:text="@string/direct_connect_headset" />

            <TextView
                android:id="@+id/senderDirectStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp" />

            <Button
                android:id="@+id/senderButton"
                style="@style/NeonButton"
                android:text="@string/sender_start" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/sender_discreet_hint"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/senderStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/sender_idle"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ===== Mode Récepteur ===== -->
        <LinearLayout
            android:id="@+id/receiverPanel"
            style="@style/Card"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/Section"
                android:text="@string/section_network" />

            <CheckBox
                android:id="@+id/autoConnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="@color/neon_cyan"
                android:text="@string/receiver_auto"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/receiverStatus"
                style="@style/Label"
                android:text="@string/receiver_searching" />

            <LinearLayout
                android:id="@+id/senderList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/Section"
                android:layout_marginTop="26dp"
                android:text="@string/direct_title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/direct_steps"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/directIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/neon_cyan"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/directHostButton"
                style="@style/NeonButton"
                android:text="@string/direct_create" />

            <TextView
                android:id="@+id/directHostStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/neon_cyan"
                android:textSize="13sp" />

            <Button
                android:id="@+id/openHotspot"
                style="@style/GhostButton"
                android:text="@string/direct_open_settings" />

            <TextView
                style="@style/Section"
                android:layout_marginTop="26dp"
                android:text="@string/section_manual" />

            <EditText
                android:id="@+id/manualIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/neon_blue"
                android:hint="@string/receiver_manual_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_dim" />

            <Button
                android:id="@+id/manualConnect"
                style="@style/NeonButton"
                android:text="@string/receiver_manual_connect" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
