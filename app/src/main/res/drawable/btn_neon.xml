<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#44FFFFFF">
    <item>
        <layer-list>
            <item android:top="-2dp" android:bottom="-2dp" android:left="-2dp" android:right="-2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#2200D4FF" />
                    <corners android:radius="30dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="#0096FF" android:centerColor="#6A5BFF" android:endColor="#B14CFF" />
                    <corners android:radius="28dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
