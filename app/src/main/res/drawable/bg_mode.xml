<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:top="-3dp" android:bottom="-3dp" android:left="-3dp" android:right="-3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#3300D4FF" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="315" android:startColor="#1B3C9E" android:endColor="#5B1FA8" />
                    <stroke android:width="2dp" android:color="#00D4FF" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#99101440" />
            <stroke android:width="1dp" android:color="#443A4580" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
